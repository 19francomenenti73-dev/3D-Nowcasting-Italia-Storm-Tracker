name: Pipeline radar 3D TITANS

on:
  schedule:
    - cron: '*/15 * * * *'
  workflow_dispatch:

jobs:
  run-tracker:
    runs-on: ubuntu-latest
    steps:
      - name: Repository checkout
        uses: actions/checkout@v3

      - name: Inizializza ambiente Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.10'

      - name: Installazione Dipendenze Scientifiche
        run: |
          python -m pip install --upgrade pip
          pip install numpy opencv-python-headless requests

      - name: Esecuzione Algoritmo TITANS + Lagrangiano
        run: python process_radar.py

      - name: Commit e Push dei dati JSON aggiornati
        run: |
          git config --global user.name "github-actions[bot]"
          git config --global user.email "github-actions[bot]@users.noreply.github.com"
          git add storm_cells.json radar_state.json
          git commit -m "Aggiornamento dati nowcasting 3D [skip ci]" || exit 0
          git push
